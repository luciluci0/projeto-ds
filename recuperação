        "def mensagem(texto):\n",
        "  print(texto)\n",
        "\n",
        "peso1 = 50\n",
        "peso2 = 25\n",
        "peso3 = 25\n",
        "peso4 = 100\n",
        "peso5 = 100\n",
        "\n",
        "nome = input(\"digite o nome do aluno:\")\n",
        "\n",
        "nota1 = float(input(f\"Digite a nota da Avaliação 1 (peso {peso1}):\"))\n",
        "nota2 = float(input(f\"Digite a nota da Avaliação 2 (peso {peso2}):\"))\n",
        "nota3 = float(input(f\"Digite a nota da Avaliação 3 (peso {peso3}):\"))\n",
        "nota4 = float(input(f\"Digite a nota da Avaliação 4 (peso {peso4}):\"))\n",
        "nota5 = float(input(f\"Digite a nota da Avaliação 5 (peso {peso5}):\"))\n",
        "\n",
        "soma_peso = peso1 + peso2 + peso3 + peso4 + peso5\n",
        "\n",
        "media = (\n",
        "    (nota1 * peso1) +\n",
        "    (nota2 * peso2) +\n",
        "    (nota3 * peso3) +\n",
        "    (nota4 * peso4) +\n",
        "    (nota5 * peso5)\n",
        "    ) / soma_peso\n",
        "\n",
        "mensagem(f\"Olá {nome}, aqui estão suas notas:\")\n",
        "\n",
        "print(f\"Nota 1 = {nota1}\")\n",
        "print(f\"Nota 2 = {nota2}\")\n",
        "print(f\"Nota 3 = {nota3}\")\n",
        "print(f\"Nota 4 = {nota4}\")\n",
        "print(f\"Nota 5 = {nota5}\")\n",
        "\n",
        "print(f\"Sua média final é igual a:{media:.2f}\")\n",
        "\n",
        "if media >= 70:\n",
        "  print(\"Você está Aprovado\")\n",
        "else:\n",
        "  print(\"Você está reprovado\")"
